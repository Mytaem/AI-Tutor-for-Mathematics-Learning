# Chép thành .env ở thư mục gốc dự án rồi điền.

# Tên miền thật -> Caddy tự cấp HTTPS. Để trống (":80") để chạy HTTP nội bộ.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Khoá vào trang quản trị. Sinh ngẫu nhiên, ví dụ:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Model sinh câu trả lời. Chỉ dùng model có giấy phép cho phép thương mại
# (qwen2.5:7b-instruct là Apache-2.0; KHÔNG dùng qwen2.5:3b — cấm thương mại).
OLLAMA_MODEL=qwen2.5:7b-instruct

# Địa chỉ web người dùng mở (link trong email trỏ về đây), ví dụ https://numeris.vn
APP_URL=http://localhost

# Gửi email xác thực tài khoản và đặt lại mật khẩu — BẮT BUỘC cho bản bán.
# Dùng được mọi nhà cung cấp có SMTP (Gmail/Google Workspace, Amazon SES, SendGrid,
# Mailgun, Zoho...). Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM=Numeris <no-reply@ten-mien-cua-ban.vn>

# Khoá cho bot Telegram gọi API thay người dùng (đặt cùng giá trị cho bot)
SERVICE_TOKEN=

# Dùng Ollama chạy sẵn trên máy chủ thay vì container:
# OLLAMA_URL=http://host.docker.internal:11434/v1

{"item_id": "MAE101-INT-013", "subject": "MAE101", "skills": ["MAE.INT.PARTS"], "statement_vi": "Tính nguyên hàm: ∫ ln(x) dx", "statement_latex": "\\int \\ln x\\,dx", "answer_type": "antiderivative", "answer": "x*log(x) - x + C", "integrand": "log(x)", "variable": "x", "difficulty": 0.65, "source": "textbook", "reference_solution_steps": [{"step": 1, "expr": "Integral(log(x), x)", "skill_id": "MAE.INT.PARTS", "explain_vi": "Đặt u = ln x, dv = dx. Khi đó du = dx/x và v = x"}, {"step": 2, "expr": "x*log(x) - x", "skill_id": "MAE.INT.PARTS", "explain_vi": "Áp dụng ∫u dv = uv − ∫v du: x·ln x − ∫x·(1/x)dx = x·ln x − x"}]}
